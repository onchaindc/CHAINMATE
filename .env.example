# ChainMate — environment variables
# =================================
# Copy to .env.local and fill in what you need:
#
#   cp .env.example .env.local
#
# EVERY variable here is optional. With an empty .env.local the app still
# runs: shared multiplayer works through the built-in file store, and the
# identity layer degrades to guest-only play. Each block below says exactly
# what it unlocks and what happens when it is absent.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# never put a secret in one. Everything else is server-only.


# ---------------------------------------------------------------------------
# Game backend
# ---------------------------------------------------------------------------
# Which store owns games. Default: "hosted".
#   hosted   — shared server store; cross-device play (recommended)
#   local    — localStorage only; games never leave the browser that made them
#   genlayer — games are ChainMate intelligent contracts on GenLayer
NEXT_PUBLIC_GAME_BACKEND=hosted


# ---------------------------------------------------------------------------
# Supabase — accounts, ratings, persistent history
# ---------------------------------------------------------------------------
# Without these: no sign-up/sign-in, every visitor plays as a guest, and
# nothing is rated (guest games are casual by design). Games still work.
#
# All three are required together — supabaseConfigured() checks for all of
# them (lib/supabase/config.ts). Project Settings → API in the dashboard.
#
# Run the migrations in supabase/migrations/ in filename order (SQL Editor →
# New query → paste → Run) before signing up, or account creation returns a
# 503 explaining the schema is missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, bypasses row-level security. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Vercel KV / Upstash Redis — fast shared game store
# ---------------------------------------------------------------------------
# Without these: the hosted backend uses the built-in file store
# (.data/games.json), which is fine for local dev and single-instance
# containers but does NOT survive serverless cold starts. Set both on Vercel.
# Both are required together — kvConfigured() checks for both.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ---------------------------------------------------------------------------
# AI commentary + post-game analysis
# ---------------------------------------------------------------------------
# Two independent switches, and BOTH are needed for LLM commentary:
#   NEXT_PUBLIC_AI_ENABLED — shows the AI panels in the UI (client)
#   AI_API_KEY             — lets the server actually call the model
# With the flag off or the key missing, games fall back to rule-based
# commentary and summaries, which are always available.
NEXT_PUBLIC_AI_ENABLED=false
AI_API_KEY=
# OpenAI-compatible endpoint. Defaults to Anthropic's API when unset.
AI_BASE_URL=
AI_MODEL=


# ---------------------------------------------------------------------------
# GenLayer (only when NEXT_PUBLIC_GAME_BACKEND=genlayer)
# ---------------------------------------------------------------------------
# Network to deploy and play on. Default: testnetBradbury.
NEXT_PUBLIC_GENLAYER_NETWORK=testnetBradbury
# Custom RPC endpoint. Defaults to the network's public RPC when unset.
NEXT_PUBLIC_GENLAYER_RPC_URL=
# Secret — funded testnet keys used server-side to sign contract calls.
# GENLAYER_PRIVATE_KEY signs for White, GENLAYER_PRIVATE_KEY_2 for Black.
GENLAYER_PRIVATE_KEY=
GENLAYER_PRIVATE_KEY_2=
